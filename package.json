{
	"name": "n8n-nodes-bouncelens",
	"version": "0.1.0",
	"description": "n8n node that checks email addresses for bad format, dead domains, typos, throwaway domains and duplicates. Runs inside n8n, no API key.",
	"license": "MIT",
	"homepage": "https://bouncelens.com/",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"email",
		"email validation",
		"email verification",
		"disposable email",
		"email typo",
		"mx"
	],
	"author": {
		"name": "BounceLens",
		"email": "hello@bouncelens.com",
		"url": "https://bouncelens.com/"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/bouncelens/n8n-nodes-bouncelens.git"
	},
	"bugs": {
		"url": "https://github.com/bouncelens/n8n-nodes-bouncelens/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [],
		"nodes": [
			"dist/nodes/BounceLens/BounceLens.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
